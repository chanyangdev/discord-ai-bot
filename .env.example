# J.A.R.V.I.S. persona configuration. BOT_PERSONA selects between the
# "jarvis" system prompt and a "plain" generic-assistant fallback; the
# JARVIS_* settings only shape the "jarvis" persona's tone.
BOT_PERSONA=jarvis
JARVIS_OWNER_HONORIFIC=sir
JARVIS_FORMALITY=balanced
JARVIS_HUMOR_LEVEL=low
JARVIS_DEFAULT_VERBOSITY=concise
JARVIS_USE_MARVEL_REFERENCES=false
JARVIS_REQUIRE_PATCH_FOR_META=true