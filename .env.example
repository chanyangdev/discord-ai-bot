DISCORD_BOT_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Verify these example model IDs in OpenRouter before using them.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemini-3.5-flash-lite,anthropic/claude-opus-5
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=discord-ai-bot
DAILY_AI_BUDGET_USD=1.00
CACHE_FIRST_THRESHOLD=0.60
ECONOMY_THRESHOLD=0.80
FREE_ONLY_THRESHOLD=1.00
MAX_REQUEST_COST_USD=0.01
NORMAL_MAX_OUTPUT_TOKENS=1024
ECONOMY_MAX_OUTPUT_TOKENS=512
ECONOMY_MODELS=qwen/qwen3.8-27b:free,google/gemini-3.5-flash-lite
PAID_LLM_ENABLED=true
MAX_CONCURRENT_AI_REQUESTS=2
MAX_AI_QUEUE_SIZE=8
AI_QUEUE_TIMEOUT_SECONDS=30
AI_SHUTDOWN_TIMEOUT_SECONDS=5
TEST_GUILD_ID=
# Local development path. Railway overrides this with /data/jarvis.db.
SQLITE_PATH=data/jarvis.db
FREE_DAILY_TOKEN_LIMIT=200000
PREMIUM_DAILY_TOKEN_LIMIT=1000000
TOKEN_RESERVATION_TTL_SECONDS=900
GEMINI_MAX_OUTPUT_TOKENS=1024
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_STATIC_TTL_SECONDS=604800
RESPONSE_CACHE_META_TTL_SECONDS=21600
RESPONSE_CACHE_PATCH_NOTES_TTL_SECONDS=86400
RESPONSE_CACHE_CLEANUP_INTERVAL_SECONDS=21600
RESPONSE_CACHE_KEY_VERSION=v1
RESPONSE_CACHE_PATCH_VERSION=0.0
