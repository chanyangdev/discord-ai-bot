OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Task-based model routing. Verify these example model IDs, pricing, and
# free-model membership in OpenRouter's model catalog before using them in
# production; OpenRouter pricing/availability/promotions can change.
OPENROUTER_GENERAL_MODELS=qwen/qwen3.7-flash,deepseek/deepseek-v4-flash-0731,qwen/qwen3.7-plus
OPENROUTER_RESEARCH_MODELS=google/gemini-3.7-flash,qwen/qwen3.7-plus,z-ai/glm-5.3-flash
OPENROUTER_FREE_MODEL=openrouter/free

# Deprecated: legacy model overrides. If set, they take priority over
# OPENROUTER_GENERAL_MODELS above (OPENROUTER_MODELS unconditionally replaces
# the general list; OPENROUTER_MODEL/LLM_MODEL then override the primary
# model on top of that) and log a deprecation warning. Do not set these in
# Railway; leaving them unset avoids any risk of them silently overriding the
# routing configuration above.
# OPENROUTER_MODELS=
# OPENROUTER_MODEL=
# LLM_MODEL=

LLM_ROUTING_MODE=normal
LLM_FREE_ONLY=false
LLM_MAX_OUTPUT_TOKENS_GENERAL=500
LLM_MAX_OUTPUT_TOKENS_RESEARCH=900
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Jarvis Discord Bot
DAILY_LLM_BUDGET_USD=1.00
DAILY_BUDGET_CACHE_THRESHOLD=0.60
DAILY_BUDGET_CHEAP_THRESHOLD=0.80
